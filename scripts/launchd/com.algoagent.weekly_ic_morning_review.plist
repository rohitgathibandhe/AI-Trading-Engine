<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.algoagent.weekly_ic_morning_review</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/Rohit/.venvs/data_engine_py310/bin/python</string>
        <string>/Users/Rohit/AI-Trading-Engine/scripts/weekly_ic_executor.py</string>
        <string>--morning-review</string>
    </array>

    <!-- Wednesday 9:00 AM IST — re-check overnight market conditions,
         refresh strikes with live data, send updated deploy link -->
