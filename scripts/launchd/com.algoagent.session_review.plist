<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.algoagent.session_review</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/Rohit/.venvs/data_engine_py310/bin/python</string>
        <string>/Users/Rohit/AI-Trading-Engine/scripts/session_review.py</string>
    </array>

    <!-- 15:40 IST Mon-Fri (5 min after eod_learning at 15:35). Grades the
         day's decisions against the backtested edge (bearish + midday +
         far-from-wall), flags missed tradable buckets or overtrading, and
         writes a journal entry to state/session_journal/<date>.md. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>40</integer></dict>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/Rohit/AI-Trading-Engine/data_engine</string>

    <key>StandardOutPath</key>
    <string>/Users/Rohit/AI-Trading-Engine/logs/session_review.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Rohit/AI-Trading-Engine/logs/session_review.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/Rohit/AI-Trading-Engine/data_engine</string>
    </dict>
</dict>
</plist>
